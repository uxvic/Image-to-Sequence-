{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameGrab",
  "version": "0.1.0",
  "identifier": "com.uxvic.framegrab",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FrameGrab",
        "width": 1180,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 660,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Turn a slice of a video into an image sequence",
    "longDescription": "FrameGrab turns part of a video into still frames you can hand to an LLM that can't take video input. Everything runs locally.",
    "copyright": "Copyright \u00a9 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "resources": [],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
